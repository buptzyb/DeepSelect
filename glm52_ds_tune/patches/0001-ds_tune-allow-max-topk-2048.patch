ds_tune patch 1/3 against DeepSelect bfa4507d935f17ebfc3d0f00ff7d3c9a4d0e5c18 (https://github.com/deepseek-ai/DeepSelect).
Allow MAX_TOPK == 2048 in the v3 (bf16) and v3_fp32 kernels; upstream lists 512/1024/4096 only.
Apply in order from the DeepSelect root: patch -p1 < 000N-*.patch (or git apply).

diff -u a/csrc/cuda_kernels/v3/topk_select.cuh b/csrc/cuda_kernels/v3/topk_select.cuh
--- a/csrc/cuda_kernels/v3/topk_select.cuh
+++ b/csrc/cuda_kernels/v3/topk_select.cuh
@@ -40,7 +40,7 @@
     using BF16Base::NUM_SEGS_PER_ROUND;
 
     static_assert(Config::target_occupancy >= 1 && Config::target_occupancy <= 8);
-    static_assert(MAX_TOPK == 512 || MAX_TOPK == 1024 || MAX_TOPK == 4096);
+    static_assert(MAX_TOPK == 512 || MAX_TOPK == 1024 || MAX_TOPK == 2048 || MAX_TOPK == 4096);  // [ds_tune patch 1]
     static constexpr bool HAS_PARTIAL_ROUNDS = NUM_SEGS_PER_ROUND > NUM_TAIL_SEGS;
     struct SharedMemoryPlan : SharedMemoryPlanBase {};
 
diff -u a/csrc/cuda_kernels/v3_fp32/topk_select.cuh b/csrc/cuda_kernels/v3_fp32/topk_select.cuh
--- a/csrc/cuda_kernels/v3_fp32/topk_select.cuh
+++ b/csrc/cuda_kernels/v3_fp32/topk_select.cuh
@@ -60,7 +60,7 @@
 
     static constexpr uint32_t PLACEHOLDER = 0xff800000; // -INF
     static constexpr uint32_t NEG_INF_BITS = 0xFF800000;
-    static_assert(MAX_TOPK == 512 || MAX_TOPK == 1024 || MAX_TOPK == 4096);
+    static_assert(MAX_TOPK == 512 || MAX_TOPK == 1024 || MAX_TOPK == 2048 || MAX_TOPK == 4096);  // [ds_tune patch 1]
     static constexpr bool HAS_PARTIAL_ROUNDS = NUM_SEGS_PER_ROUND > NUM_TAIL_SEGS;
 
     struct SharedMemoryPlanFP32 : SharedMemoryPlanBase {};
